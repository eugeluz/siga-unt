rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for courses, dates, and students (needed for landing page)
    match /cursos/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /fechas/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /alumnos/{document} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }
    match /inscripciones/{document} {
      allow read: if true;
      allow create: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // Admin-only collections
    match /docentes/{document} {
      allow read, write: if request.auth != null;
    }
    match /facultades/{document} {
      allow read, write: if request.auth != null;
    }
    // Noticias públicas (página principal) — escritura solo admin
    match /noticias/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}


